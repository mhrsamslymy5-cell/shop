# Database (Railway Postgres plugin provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/aurevonfilter"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Admin login (never hardcode in source; set only via env)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="aurevon"
ADMIN_JWT_SECRET="change-this-to-another-long-random-string"

# Public base URL, used to build subscription URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
